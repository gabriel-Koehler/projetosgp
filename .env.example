# Chave usada para assinar o cookie de sessão. Obrigatória em produção.
SECRET_KEY=troque-por-um-valor-aleatorio
# Credenciais do professor (mock da N1; na N2 passam a vir do Supabase).
PROFESSOR_USERNAME=professor
PROFESSOR_PASSWORD=123456
PROFESSOR_NOME=Professor
# true em produção (HTTPS): o cookie de sessão só trafega por HTTPS.
SESSION_HTTPS_ONLY=false
# Origens do front-end autorizadas, separadas por vírgula (vazio = mesma origem).
CORS_ORIGINS=
# Endereço público do sistema, usado no link do QR Code (ex.: https://provafacil.onrender.com).
PUBLIC_BASE_URL=

# Front-end Node / proxy para a API Python.
HOST=127.0.0.1
PORT=3000
API_TARGET=http://127.0.0.1:8000
# Preparação N2: ainda não consumidas pela main N1; somente no servidor.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
