<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Painel do Professor · ProvaFácil</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('partials/header', { username }) %>

    <main>
      <div class="page-heading">
        <h1>Painel do professor</h1>
        <p>Bem-vindo, <strong><%= username %></strong></p>
      </div>
      <div class="container">
      <section class="panel">
        <h2>Banco de questões</h2>
        <form method="POST" action="/questions" class="question-form">
          <input type="text" name="statement" placeholder="Enunciado da questão" required />
          <div class="option-grid">
            <input type="text" name="optionA" placeholder="Alternativa A" required />
            <input type="text" name="optionB" placeholder="Alternativa B" required />
            <input type="text" name="optionC" placeholder="Alternativa C" required />
            <input type="text" name="optionD" placeholder="Alternativa D" required />
          </div>
          <label>
            Gabarito
            <select name="answer">
              <option value="A">A</option>
              <option value="B">B</option>
              <option value="C">C</option>
              <option value="D">D</option>
            </select>
          </label>
          <button type="submit">Salvar questão</button>
        </form>

        <% if (questions && questions.length) { %>
          <ul class="question-list">
            <% questions.forEach((question) => { %>
              <li>
                <strong><%= question.id %>:</strong> <%= question.statement %>
                <span>(Resposta correta: <%= question.answer %>)</span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="panel">
        <h2>Gerar versões</h2>
        <form method="POST" action="/versions" class="version-form">
          <label>
            Quantidade de versões
            <input type="number" name="versionCount" min="1" max="10" value="3" required />
          </label>
          <label>
            Nome das versões
            <input type="text" name="naming" value="A,B,C" placeholder="A,B,C" />
          </label>
          <button type="submit">Gerar versões</button>
        </form>

        <% if (versions && versions.length) { %>
          <div class="version-list">
            <% versions.forEach((version) => { %>
              <div class="version-card">
                <h3><%= version.name %></h3>
                <p><%= version.questions.length %> questões</p>
                <a href="/student?version=<%= encodeURIComponent(version.name) %>">Consultar gabarito</a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
